# Copy this file to .env and fill in your own values.
# Never commit the real .env — it holds PBX broker credentials.

# ---- server ----
PORT=4100
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COMPANY_NAME=Cerdik

# ---- postgres (matches docker-compose.yml) ----
DATABASE_URL=postgres://cerdik:cerdik@localhost:5432/cerdik_crm

# ---- PBX (CD-series, MQTT) ----
# The broker YOU host — the PBX connects out to it, see docs/MQTT-API.md.
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# The PBX's own serial — all its topics are rooted at device/<serial>/api/v1.0/
MQTT_DEVICE_SERIAL=

# ---- web ----
# Not needed normally: the web app talks to the API same-origin (proxied to
# the server in dev, served by the server itself in production). Only set
# these to point the web app at a server on a different host/port.
#VITE_API_URL=http://localhost:4100
#VITE_WS_URL=ws://localhost:4100/ws

# ---- seed (npm run seed -w server) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_EXTENSION=
